    "onboarding_intro_body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YomiPlay uses on‑device AI speech recognition to turn audio / video into study‑friendly subtitles, helping with shadowing and multilingual listening practice. You can import media files, podcasts, or ZIP study bundles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YomiPlay はローカルの AI 音声認識を使って、音声・動画から学習用の字幕を生成し、シャドーイングや多言語リスニングをサポートするアプリです。音声／動画ファイルやポッドキャスト、ZIP 学習素材をインポートできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YomiPlay 使用本地 AI 语音识别，将音频 / 视频生成可学习的字幕，辅助影子跟读和多语言听力练习。你可以导入音视频文件、播客或 ZIP 学习资料。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YomiPlay 使用本地 AI 語音辨識，將音訊／影片轉成可學習的字幕，輔助影子跟讀與多語言聽力練習。你可以匯入音視訊檔案、Podcast 或 ZIP 學習資料。"
          }
        }
      }
    },
