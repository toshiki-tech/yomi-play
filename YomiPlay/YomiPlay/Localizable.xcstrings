    "settings_header_pro_subtitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thank you for your support! Enjoy unlimited recognition plus full import/export workflows for daily listening, shadowing, and your personal learning library."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご利用ありがとうございます。無制限認識に加え、取り込み・書き出しまで一気通貫で、毎日の精聴・シャドーイングと語料管理をサポートします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感谢支持！您已享无限识别，并可全链路管理音视频学习资料的导入与导出，专注每日精听、跟读与个人素材库沉淀。"
