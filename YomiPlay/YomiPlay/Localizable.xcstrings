    "onboarding_disclaimer_body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app is intended for personal language learning only. Please ensure you have the legal right to use any audio, video, or subtitle content you import or download, and keep your usage within fair use / personal study scope. You are solely responsible for any copyright or legal issues arising from the content you use or share."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本アプリは個人の語学学習を目的としたツールです。インポート／ダウンロードする音声・動画・字幕などのコンテンツについては、必ず合法な利用権限を確認し、私的学習の範囲に留めてご利用ください。著作権保護されたコンテンツの利用・共有に伴う責任は、利用者ご自身に帰属します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用仅作为个人语言学习工具使用。请确保你导入或下载的音视频、字幕等内容拥有合法使用权限，或仅在合理使用范围内自用学习。对于因导入、分享受版权保护内容而产生的法律责任，由用户本人承担。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本應用僅作為個人語言學習工具使用。請確保你匯入或下載的音視訊、字幕等內容擁有合法使用權限，或僅在合理使用範圍內自用學習。對於因匯入、分享受版權保護內容而產生的法律責任，由用戶本人承擔。"
          }
        }
      }
    },
    "onboarding_disclaimer_title" : {
      "localizations" : {
