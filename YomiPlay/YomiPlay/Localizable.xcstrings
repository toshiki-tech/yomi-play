    "podcast_download_network_unreachable" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not reach the podcast server (DNS, TLS, or connection failed). Your network may be restricted, or the source is unavailable from your region. Try a VPN, another source, or import a local file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポッドキャストのサーバーに接続できませんでした（DNS / TLS / 接続切断など）。ネットワークが制限されているか、お住まいの地域からアクセスできない可能性があります。VPN、別のソース、またはローカルファイルでの取り込みをお試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接到播客服务器（DNS / TLS / 连接被中断等）。可能是网络受限，或该资源在您所在地区不可访问。可尝试使用 VPN、换用其他来源，或改为本地文件导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連接到播客伺服器（DNS / TLS / 連線中斷等）。可能是網路受限，或該資源在您所在地區無法存取。可嘗試使用 VPN、改用其他來源，或改為本機檔案匯入。"
          }
        }
      }
    },
