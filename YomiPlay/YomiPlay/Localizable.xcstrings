    "settings_debug_force_free_footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, the app treats you as a free user so you can open the paywall and test purchases again (e.g. after buying lifetime in the sandbox). Real entitlements are unchanged; turn off to restore normal Pro behavior. Debug builds only."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると StoreKit上の権利に関係なく画面は無料ユーザー扱いになり、サンドボックスで買い切り後なども購読画面のテストができます。実際の権利は変わりません。オフにすると通常どおり Pro 表示に戻ります。開発ビルド専用です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后界面将始终按免费用户显示，便于在沙盒已购终身等情况再次打开付费墙测试；真实权益未被撤销，关闭本项即可恢复正常 Pro 显示。仅在开发构建中可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟後介面將一律以免費使用者顯示，便於在沙盒已購買終身等情況再次開啟付費牆測試；實際權益並未取消，關閉後即恢復正常 Pro 顯示。僅開發建置可用。"
          }
        }
      }
    },
    "settings_debug_force_free_toggle" : {
      "localizations" : {
        "en" : {
