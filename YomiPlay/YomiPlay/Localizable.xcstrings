    "translation_failed_explanation" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Translation failed.\n\nPlease check:\n1) The target language is installed on this iPhone.\n2) The language pair is supported by Apple's on-device translation.\n\nYou can install languages in Settings → General → Language & Region (or the first time you use Translate), then try again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻訳に失敗しました。\n\n次をご確認ください：\n1) 翻訳先言語が iPhone にインストールされている\n2) 言語ペアが Apple のデバイス上翻訳でサポートされている\n\n言語は「設定 → 一般 → 言語と地域」（または翻訳初回利用時）で追加できます。追加後に再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻译失败。\n\n请检查：\n1）目标语言是否已在 iPhone 上安装\n2）该语言对是否受苹果设备端翻译支持\n\n可在「设置 → 通用 → 语言与地区」（或首次使用翻译时）下载语言后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻譯失敗。\n\n請檢查：\n1）目標語言是否已在 iPhone 上安裝\n2）該語言配對是否受 Apple 裝置端翻譯支援\n\n可在「設定 → 一般 → 語言與地區」（或首次使用翻譯時）下載語言後再試。"
          }
        }
      }
    },
    "translation_network_hint_message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For best translation results:\n1) Update iPhone to iOS 26+ or the latest iOS.\n2) In system Translation settings, set Apple's Translate as the default app.\n3) In Manage Languages, download Chinese/Japanese/English in advance.\n\nThis improves reliability in offline mode and on-device translation mode."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻訳を安定して使うには：\n1) iPhone を iOS 26 以降または最新 iOS に更新\n2) システムの翻訳設定で、デフォルト App を Apple 純正「翻訳」に設定\n3) 「言語を管理」で中国語・日本語・英語を事前にダウンロード\n\nオフライン時やデバイス上翻訳モードでも動作しやすくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为保证翻译稳定，建议先完成以下设置：\n1）将 iPhone 升级到 iOS 26+ 或最新版 iOS\n2）在系统翻译设置中，将默认翻译 App 设为苹果自带“翻译”\n3）在“管理语言”中提前下载中/日/英语言包\n\n这样在离线或开启设备端翻译模式时更稳定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為確保翻譯穩定，建議先完成以下設定：\n1）將 iPhone 升級到 iOS 26+ 或最新版本 iOS\n2）在系統翻譯設定中，將預設翻譯 App 設為 Apple 內建「翻譯」\n3）在「管理語言」先下載中／日／英語言包\n\n這樣在離線或開啟裝置端翻譯模式時會更穩定。"
          }
        }
      }
    },
    "translation_network_hint_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
