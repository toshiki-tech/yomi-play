    "podcast_link_unresolvable" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This link could not be resolved to a playable audio file. Use a direct .mp3/.m4a (etc.) link, an RSS feed URL, or import a local file. Apple Podcasts web pages, YouTube, and similar players usually cannot be used here. For podcasts, open Import from podcast, search by keyword, and pick an episode."
